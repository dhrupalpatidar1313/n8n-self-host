# n8n self-hosting configuration. Copy to .env (or run ./setup.sh, which also
# generates every CHANGE_ME secret). Keep .env out of version control.
# Do not put quotes or spaces in values.

# ---------------------------------------------------------------- Deployment
COMPOSE_PROJECT_NAME=n8n
# Optional profiles, comma separated: https (Traefik + Let's Encrypt), ngrok
COMPOSE_PROFILES=

# Versions. The sandbox API, runner and sandbox images ship as one release.
N8N_VERSION=2.43.4
N8N_SANDBOX_VERSION=1.8.1
# Use your own image (e.g. dhrupalpatidar1313/n8n-compose-n8n) instead of the official one
N8N_IMAGE=docker.io/n8nio/n8n

# ---------------------------------------------------------- Data (local mount)
# All persistent data lives here: <DATA_DIR>/postgres, /n8n, /files
# Use an absolute path (e.g. /srv/n8n) for a dedicated disk. Back this folder up.
DATA_DIR=./data

# ------------------------------------------------------- Public URL / network
# Hostname users open in the browser. localhost for a local trial.
N8N_HOST=localhost
# http for a local/LAN install, https when behind Traefik/ngrok/a load balancer
N8N_PROTOCOL=http
# Full external URL incl. trailing slash. Used for webhooks and OAuth callbacks.
WEBHOOK_URL=http://localhost:5678/
# Host interface/port n8n is published on. 0.0.0.0 = reachable from the network,
# 127.0.0.1 = local only (use this with the https profile or another proxy).
N8N_BIND_ADDRESS=127.0.0.1
N8N_HOST_PORT=5678
# Number of reverse proxies in front of n8n (1 for Traefik/ngrok/one LB)
N8N_PROXY_HOPS=0
# Set true when served over HTTPS
N8N_SECURE_COOKIE=false
# Docker network name and subnet (change if it clashes with your corporate network)
DOCKER_NETWORK_NAME=n8n-net
DOCKER_NETWORK_SUBNET=172.28.0.0/16

# Traefik (profile "https"): needs DNS for N8N_HOST pointing at this server
SSL_EMAIL=admin@example.com
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# ngrok (profile "ngrok")
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# -------------------------------------------------------------------- n8n core
GENERIC_TIMEZONE=UTC
N8N_LOG_LEVEL=info
# Max request payload in MB
N8N_PAYLOAD_SIZE_MAX=16
# Delete finished executions older than this many hours (14 days)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
# Container limits
N8N_MEM_LIMIT=4g
N8N_CPU_LIMIT=2
# Encrypts stored credentials. Never change it after first start; back it up.
N8N_ENCRYPTION_KEY=CHANGE_ME

# ------------------------------------------------------------------- Database
POSTGRES_IMAGE=postgres:18
# Admin user (only used to initialise the database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n
# Least-privilege user n8n connects as. Applied on first start of an empty DB.
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=CHANGE_ME

# -------------------------------------------------- Task runners (Code node)
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME

# ------------------------------------------- AI assistant (sandbox + search)
# Optional: model API key for the n8n Assistant, Brave key to replace SearXNG
N8N_INSTANCE_AI_MODEL_API_KEY=
INSTANCE_AI_BRAVE_SEARCH_API_KEY=
SEARXNG_SECRET=CHANGE_ME
# Each secret appears twice: the API side and the client side must match.
SANDBOX_API_KEYS=CHANGE_ME
N8N_SANDBOX_SERVICE_API_KEY=CHANGE_ME
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=CHANGE_ME
SANDBOX_RUNNER_REGISTRATION_TOKEN=CHANGE_ME
SANDBOX_API_RUNNER_API_KEY=CHANGE_ME
SANDBOX_RUNNER_API_KEYS=CHANGE_ME
